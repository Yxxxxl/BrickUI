<Page
    x:Class="BrickUI.Views.LogConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BrickUI.Controls.LogConsole;assembly=BrickUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BrickUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="960"
    Height="600"
    Background="#FFFFFF"
    mc:Ignorable="d">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12" Orientation="Vertical">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="#111827"
                Text="MCU 控制台" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12"
                Foreground="#6B7280"
                Text="支持严重性与自定义颜色，新增日志自动滚动到底部" />
        </StackPanel>

        <controls:LogConsole
            Grid.Row="1"
            Margin="0,0,0,12"
            AutoScroll="True"
            ClearCommand="{Binding ClearCommand}"
            ItemsSource="{Binding Entries}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Height="32"
                Padding="8"
                VerticalContentAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                Foreground="#111827"
                Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="12,4"
                    Command="{Binding AddInfoCommand}"
                    Content="Info" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,4"
                    Command="{Binding AddWarningCommand}"
                    Content="Warn" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,4"
                    Command="{Binding AddErrorCommand}"
                    Content="Error" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,4"
                    Command="{Binding AddCustomCommand}"
                    Content="Add" />
                <Button
                    Padding="12,4"
                    Command="{Binding ClearCommand}"
                    Content="Clear" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
