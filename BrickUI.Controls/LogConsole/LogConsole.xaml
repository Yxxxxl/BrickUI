<UserControl
    x:Class="BrickUI.Controls.LogConsole"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BrickUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Border
        Padding="10"
        Background="#FFFFFF"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Click="OnClearClicked" Header="清空" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <ScrollViewer x:Name="PART_ScrollViewer" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Width" Value="8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <local:FixedThumbTrack
                                            x:Name="PART_Track"
                                            IsDirectionReversed="True"
                                            Maximum="{TemplateBinding Maximum}"
                                            Minimum="{TemplateBinding Minimum}"
                                            Orientation="{TemplateBinding Orientation}"
                                            Value="{TemplateBinding Value}"
                                            ThumbLength="28">
                                            <local:FixedThumbTrack.DecreaseRepeatButton>
                                                <RepeatButton
                                                    Command="ScrollBar.PageUpCommand"
                                                    IsHitTestVisible="False"
                                                    Opacity="0"
                                                    Style="{x:Null}" />
                                            </local:FixedThumbTrack.DecreaseRepeatButton>
                                            <local:FixedThumbTrack.IncreaseRepeatButton>
                                                <RepeatButton
                                                    Command="ScrollBar.PageDownCommand"
                                                    IsHitTestVisible="False"
                                                    Opacity="0"
                                                    Style="{x:Null}" />
                                            </local:FixedThumbTrack.IncreaseRepeatButton>
                                            <local:FixedThumbTrack.Thumb>
                                                <Thumb Background="#475569" />
                                            </local:FixedThumbTrack.Thumb>
                                        </local:FixedThumbTrack>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="Thumb">
                        <Setter Property="MinHeight" Value="20" />
                        <Setter Property="Background" Value="#E5E7EB" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Opacity="0.9" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D1D5DB" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#9CA3AF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="PART_Items" ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LogEntry}">
                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontFamily="Consolas"
                                    Foreground="#9CA3AF"
                                    Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    FontFamily="Consolas"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Foreground}"
                                    Text="{Binding Severity}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    Foreground="{Binding Foreground}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>

</UserControl>
