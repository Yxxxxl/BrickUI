<UserControl
    x:Class="BrickUI.DemoforDontnet.Views.SideMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BrickUI.Controls;assembly=BrickUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#F8FAFC">
        <controls:SideMenu
            ItemsSource="{Binding MenuItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            ToggleBackgroundCollapsed="#F8FAFC"
            ToggleForegroundCollapsed="#0F172A">
            <controls:SideMenu.RightContent>
                <Viewbox>
                    <Grid Margin="24">
                        <ContentControl Content="{Binding ShowView}" />
                    </Grid>
                </Viewbox>
            </controls:SideMenu.RightContent>
        </controls:SideMenu>
    </Grid>
</UserControl>
